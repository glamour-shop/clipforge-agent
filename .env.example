# ClipForge Environment Configuration
# Add your free API keys below. If left blank, ClipForge will run in Demo/Sample mode.

# YouTube Data API v3 (Free 10,000 units/day)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Google Gemini API Key (Free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Your own YouTube Channel ID (optional, to automatically clear your own videos)
OWN_CHANNEL_ID=
